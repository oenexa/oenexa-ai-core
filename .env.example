# ==============================================================================
# OENEXA AI Engineer - Environment Configuration Template
# Copy to .env and customize. Never commit production credentials to git.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Security & Authentication (minimum 32 characters of cryptographic entropy)
OENEXA_JWT_SECRET=oenexa-ai-engineer-jwt-secret-key-32bytes-min-sample

# Database Configuration (PostgreSQL / Embedded H2 for local development)
DB_URL=jdbc:postgresql://localhost:5432/oenexa
DB_USER=oenexa
DB_PASSWORD=oenexa

# LLM & AI Configuration
# 'echo' = offline mock provider (no API key required)
# 'spring-ai' = Spring AI OpenAI provider
OENEXA_LLM_PROVIDER=echo
OPENAI_API_KEY=disabled

# Observability (OpenTelemetry & Prometheus)
OTEL_SAMPLING=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
